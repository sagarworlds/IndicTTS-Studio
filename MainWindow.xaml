<Window x:Class="IndicF5.Net.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IndicF5 TTS"
        Width="1140" Height="740"
        MinWidth="960" MinHeight="620"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Toolbar -->
            <RowDefinition Height="*"/>      <!-- Main Content -->
            <RowDefinition Height="Auto"/>   <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ═══ TOP TOOLBAR ═══ -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <WrapPanel VerticalAlignment="Center">
                <!-- Generate Button -->
                <Button x:Name="BtnGenerate" Content="🔊  Generate Speech"
                        Style="{StaticResource AccentButton}"
                        Click="BtnGenerate_Click" Margin="0,0,12,0" />

                <!-- Cancel Button -->
                <Button x:Name="BtnCancel" Content="✕ Cancel"
                        Style="{StaticResource DangerButton}"
                        Click="BtnCancel_Click" Margin="0,0,12,0"
                        Visibility="Collapsed" />

                <!-- Clear / Reset Button -->
                <Button x:Name="BtnClear" Content="🔄  Clear &amp; Reset"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnClear_Click" Margin="0,0,24,0"
                        ToolTip="Clear text input, reset progress and logs to start a fresh session" />

                <!-- Speed -->
                <TextBlock Text="Speed" Foreground="{StaticResource FgDimBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                <Slider x:Name="SliderSpeed" Minimum="0.5" Maximum="2.0" Value="1.0"
                        Width="110" VerticalAlignment="Center" Margin="0,0,6,0"
                        TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                <TextBlock x:Name="TxtSpeedValue" Text="1.0x"
                           Foreground="{StaticResource FgBrush}" FontSize="13"
                           VerticalAlignment="Center" Margin="0,0,24,0" Width="36"/>

                <!-- Steps -->
                <TextBlock Text="Steps" Foreground="{StaticResource FgDimBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                <ComboBox x:Name="CmbSteps" Width="65" SelectedIndex="2"
                          FontSize="13" VerticalAlignment="Center">
                    <ComboBoxItem Content="8"/>
                    <ComboBoxItem Content="16"/>
                    <ComboBoxItem Content="32"/>
                </ComboBox>
            </WrapPanel>
        </Border>

        <!-- ═══ MAIN CONTENT ═══ -->
        <Grid Grid.Row="1" Margin="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- ─── LEFT PANEL: Input ─── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Text Header with Clear Text button -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Text to Synthesize" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource FgBrush}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Clear Text"
                            Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="11"
                            Click="BtnClearText_Click" ToolTip="Clear input text"/>
                </Grid>

                <TextBox Grid.Row="1" x:Name="TxtInput"
                         Style="{StaticResource DarkTextBox}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="15" FontFamily="Nirmala UI, Segoe UI"
                         Text="कृत्रिम बुद्धिमत्ता आणि भाषा तंत्रज्ञान आज वेगाने विकसित होत आहे.&#x0a;भारतीय भाषांसाठी अत्याधुनिक तंत्रज्ञानाचा वापर करून आवाज निर्मिती करणे आता अधिक सोपे आणि प्रभावी झाले आहे.&#x0a;हे तंत्रज्ञान आपल्या संवादाला एक नवीन दिशा आणि ऊर्जा देते."
                         Margin="0,0,0,12"/>

                <TextBlock Grid.Row="2" Text="Reference Voice Sample" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource FgBrush}" Margin="0,0,0,6"/>

                <!-- Reference Audio Picker with Play & Validation -->
                <Grid Grid.Row="3" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Row="0" Grid.Column="0" x:Name="TxtRefAudio"
                             Style="{StaticResource DarkTextBox}"
                             Text="my_voice.wav" TextChanged="TxtRefAudio_TextChanged"/>

                    <Button Grid.Row="0" Grid.Column="1" Content="Browse..."
                            Style="{StaticResource SecondaryButton}"
                            Margin="6,0,0,0" Click="BtnBrowseAudio_Click"/>

                    <Button Grid.Row="0" Grid.Column="2" x:Name="BtnPlayRefAudio" Content="▶ Play Ref"
                            Style="{StaticResource SecondaryButton}"
                            Margin="6,0,0,0" Click="BtnPlayRefAudio_Click" IsEnabled="False"
                            ToolTip="Play reference voice recording"/>

                    <!-- Validation Info -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                               x:Name="TxtRefAudioValidation"
                               Text="Validating audio..." FontSize="12"
                               Foreground="{StaticResource FgDimBrush}" Margin="2,4,0,0"/>
                </Grid>

                <TextBlock Grid.Row="4" Text="Reference Text (Voice Transcript)" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource FgBrush}" Margin="0,0,0,6"/>

                <TextBox Grid.Row="5" x:Name="TxtRefText"
                         Style="{StaticResource DarkTextBox}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Height="75" VerticalScrollBarVisibility="Auto"
                         FontSize="14" FontFamily="Nirmala UI, Segoe UI"
                         Text="नमस्कार मित्रांनो, माझं नाव सागर आहे. आज आपण एका अतिशय महत्त्वाच्या विषयाबद्दल माहिती घेणार आहोत."/>
            </Grid>

            <!-- ─── RIGHT PANEL: Progress + Playback ─── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Overall Conversion Progress Card -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                        CornerRadius="6" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- Header Row -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Conversion Progress" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource FgBrush}"/>
                                <Border x:Name="BadgeStage" Background="{StaticResource SurfaceLightBrush}"
                                        CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtStageBadge" Text="READY" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource FgDimBrush}"/>
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="TxtOverallPercent" Grid.Column="1"
                                       Text="0%" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Grid>

                        <!-- Overall Progress Bar -->
                        <ProgressBar x:Name="ProgressBarOverall"
                                     Height="10" Minimum="0" Maximum="100" Value="0"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="{StaticResource SurfaceLightBrush}"
                                     BorderThickness="0" Margin="0,0,0,8"/>

                        <!-- Batch & Step Info -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtBatchStepInfo" Text="Ready to synthesize."
                                       FontSize="12" Foreground="{StaticResource FgDimBrush}"/>
                            <TextBlock Grid.Column="1" x:Name="TxtTimeMetrics" Text=""
                                       FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Status Log -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceLightBrush}"
                        CornerRadius="6" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Status Log" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource FgDimBrush}"
                                   Margin="12,8,12,4"/>
                        <ScrollViewer Grid.Row="1" x:Name="LogScroller"
                                      VerticalScrollBarVisibility="Auto"
                                      Margin="0,0,0,6">
                            <TextBlock x:Name="TxtLog" TextWrapping="Wrap"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="12" Foreground="{StaticResource FgBrush}"
                                       Margin="12,0,12,4"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Generated Audio Playback Section -->
                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                        CornerRadius="6" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <TextBlock Grid.Row="0" Text="Generated Audio Playback" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource FgBrush}" Margin="0,0,0,8"/>

                        <!-- Playback Controls -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Button x:Name="BtnPlay" Content="▶" FontSize="18" Width="44" Height="40"
                                    Style="{StaticResource AccentButton}" Padding="0"
                                    Click="BtnPlay_Click" IsEnabled="False"
                                    ToolTip="Play / Pause generated speech"/>
                            <Button x:Name="BtnStop" Content="⏹" FontSize="16" Width="44" Height="40"
                                    Style="{StaticResource SecondaryButton}" Padding="0"
                                    Click="BtnStop_Click" Margin="8,0,0,0" IsEnabled="False"
                                    ToolTip="Stop playback"/>
                            <Button x:Name="BtnSaveAs" Content="💾 Save WAV..."
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BtnSaveAs_Click" Margin="16,0,0,0" IsEnabled="False"
                                    ToolTip="Save synthesized speech as WAV file"/>
                        </StackPanel>

                        <!-- Position Slider -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtPlayPosition" Text="0:00"
                                       Foreground="{StaticResource FgDimBrush}" FontSize="12"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Slider Grid.Column="1" x:Name="SliderPosition"
                                    Minimum="0" Maximum="100" Value="0"
                                    VerticalAlignment="Center" IsEnabled="False"
                                    ValueChanged="SliderPosition_ValueChanged"/>
                            <TextBlock Grid.Column="2" x:Name="TxtPlayDuration" Text="0:00"
                                       Foreground="{StaticResource FgDimBrush}" FontSize="12"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══ STATUS BAR ═══ -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="Ready — Load models and enter text to begin."
                           Foreground="{StaticResource FgDimBrush}" FontSize="12"/>
                <TextBlock Grid.Column="1" x:Name="TxtModelInfo"
                           Text="IndicF5 TTS • .NET 10 + ONNX Runtime"
                           Foreground="{StaticResource FgDimBrush}" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>
